#!/bin/sh
set -e

PKGNAME=wg-wrangler
USERNAME=wg-wrangler_manager

case "$1" in
    remove|purge)
        # Revert group of /etc/wireguard
        if [ -d /etc/wireguard ]; then
            chgrp --silent --recursive root /etc/wireguard/
        fi

        # remove sudoers entry
        rm -f /etc/sudoers.d/$PKGNAME
        ;;
esac

case "$1" in
    purge)
        # The account survives a plain remove, it only goes on purge.
        if [ -x "$(command -v deluser)" ]; then
            deluser --quiet --system "$USERNAME" >/dev/null || true
        else
            echo >&2 "not removing $USERNAME system account because deluser command was not found"
        fi
        ;;
esac

# Note the absence of an upgrade branch. This script used to run its full body
# on every invocation, including "upgrade", so each upgrade reverted the group
# of /etc/wireguard, deleted the sudoers rule and tried to delete the account,
# relying on the new postinst to put everything back. When that postinst failed
# the system was left without the permissions the service needs.

exit 0
